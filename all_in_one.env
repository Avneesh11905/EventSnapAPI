# =========================================================================
# EventSnap All-In-One Local Environment Setup
# Intended for use with: docker-compose.all_in_one.yml
# =========================================================================

# -------------------------------------------------------------------------
# MANDATORY INFRASTRUCTURE VARIABLES (Always Required)
# -------------------------------------------------------------------------
# Docker Compose strictly reads these to configure the database, redis, 
# rabbitmq, and minio containers BEFORE your apps start. YOU MUST SET THESE!

# Used by `eventsnap_rabbitmq` container to initialize credentials
RABBITMQ_DEFAULT_USER="<RABBITMQ_USER>"
RABBITMQ_DEFAULT_PASS="<RABBITMQ_PASSWORD>"

# Used by `es-minio` container to initialize the root admin account
MINIO_ROOT_USER="<MINIO_USER>"
MINIO_ROOT_PASSWORD="<MINIO_PASSWORD>"

# Used by `es-postgres` container to initialize the main user and database
POSTGRES_USER="<POSTGRES_USER>"
POSTGRES_PASSWORD="<POSTGRES_PASSWORD>"
POSTGRES_DB="<POSTGRES_DB>"

# -------------------------------------------------------------------------
# WORKFLOW A: With Infisical (Recommended)
# -------------------------------------------------------------------------
# 1. Provide your Infisical Machine Identity credentials (or Token) below. 
# 2. The apps will automatically fetch all application secrets from Infisical.
# 3. You can completely ignore the "Application Variables" section below!

# Used by `es-main_api`, `es-celery_worker`, and `es-inference_api` to fetch secrets
# INFISICAL_API_URL="https://app.infisical.com"
# INFISICAL_PROJECT_ID="d8d040c0-0c42-4d30-b89f-3d6593808a28"
# INFISICAL_MACHINE_IDENTITY_CLIENT_ID=""
# INFISICAL_MACHINE_IDENTITY_CLIENT_SECRET=""
# INFISICAL_TOKEN=""

# -------------------------------------------------------------------------
# WORKFLOW B: Without Infisical (Manual Fallback)
# -------------------------------------------------------------------------
# 1. Leave the Infisical credentials above blank! The bash scripts will run natively.
# 2. You DO NOT need to manually fill out the variables below! As long as 
#    you filled out the MANDATORY variables at the top of this file, Docker 
#    Compose will automatically assemble these URLs for you.

# Used by `es-main_api`, `es-db_migration` and `es-celery_worker` to connect to PostgreSQL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@es-postgres:5432/${POSTGRES_DB}"

# Used by `es-main_api` and `es-celery_worker` to connect to the RabbitMQ broker
RABBITMQ_URL="amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@eventsnap_rabbitmq:5672/"
# Used by `es-main_api` and `es-celery_worker` to connect to S3/Minio object storage
STORAGE_ACCESS_KEY="${MINIO_ROOT_USER}"
STORAGE_SECRET_KEY="${MINIO_ROOT_PASSWORD}"
STORAGE_BUCKET_NAME="eventsnap-bucket"
STORAGE_ENDPOINT="http://es-minio:9000"

# Used by `es-main_api` to route requests to the Inference service
INFERENCE_API_URL="http://es-inference_api:5000"

# Used by `es-main_api` for facial recognition thresholds
SIMILARITY_THRESHOLD=0.55
MIN_MATCHES=2
